# Copy to .env and adjust. Never commit the real .env file.

# --- Application ---
NODE_ENV=development
PORT=9000
LOG_LEVEL=http
# Use postgresql://...@localhost:5432/... when running `npm run dev` on the host.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devops_db
# Set to true for managed databases that require TLS (e.g. Neon, Supabase).
DATABASE_SSL=false
# Optional: protect /metrics with "Authorization: Bearer <token>".
METRICS_TOKEN=

# --- docker compose ---
APP_PORT=9000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devops_db
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
